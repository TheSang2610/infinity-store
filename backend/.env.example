# ---- Bat buoc ----
# PostgreSQL. Chay thu khong can cai Postgres: DATABASE_URL=pglite:./.pglite
# Neon/Supabase: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=postgres://postgres:matkhau@localhost:5432/infinity_store
# Dia chi frontend (dang nhap Google, passkey, chong CSRF)
FRONTEND_URL=http://localhost:3000
# Tai khoan Giam doc tao boi `npm run db:seed` (thay cho ADMIN_PASSWORD cu)
OWNER_USERNAME=admin
OWNER_PASSWORD=dat-mat-khau-dai-va-kho-doan
# PHAI giong HR_DATA_KEY cua ban Cloudflare cu, neu khong ho so nhan su da ma hoa se khong doc duoc
HR_DATA_KEY=
# Chuoi ngau nhien dai, dat GIONG het ben frontend (de backend biet IP that cua khach)
INTERNAL_API_SECRET=

# ---- Kho tep: local (thu muc UPLOAD_DIR) hoac blob (Vercel Blob, private) ----
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
BLOB_READ_WRITE_TOKEN=

# ---- Thanh toan ----
CASSO_WEBHOOK_SECRET=
# So tai khoan nhan tien, so MoMo, hotline... nam trong CSDL: trang quan tri > Cai dat cua hang.

# ---- Dang nhap Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# De trong = <FRONTEND_URL>/api/account/google/callback
GOOGLE_REDIRECT_URI=

# ---- OTP xac minh / quen mat khau (Twilio Verify) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Passkey cham cong: ten mien nhan vien mo trang (de trong = lay tu FRONTEND_URL) ----
PASSKEY_RP_ID=
PASSKEY_ORIGINS=

# ---- Cham cong khuon mat (Python DeepFace) - de trong = tam tat ----
FACE_API_URL=
FACE_API_KEY=
# FACE_API_URL tro ve may nay (vd http://127.0.0.1:8001) va da cai python-ai/.venv thi backend tu bat
# may chu khuon mat khi co nguoi cham cong, khong dung FACE_IDLE_MINUTES phut thi tu tat (0 = khong tat).
# Mac dinh: bat o dev, tat o production.
FACE_AUTOSTART=
FACE_IDLE_MINUTES=15

PORT=4000
