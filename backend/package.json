{
  "name": "infinity-store-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API cho Infinity Store (Express + PostgreSQL)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:import-d1": "tsx --env-file-if-exists=.env scripts/import-d1.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "@vercel/blob": "2.8.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "express": "5.1.0",
    "multer": "2.4.0",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "swagger-ui-express": "5.0.1",
    "vietnam-qr-pay": "1.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.7",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "drizzle-kit": "0.31.10",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
